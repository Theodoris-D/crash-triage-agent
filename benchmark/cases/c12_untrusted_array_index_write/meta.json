{
  "id": "c12_untrusted_array_index_write",
  "title": "Write to a stack slot at an untrusted negative index",
  "cwe": "CWE-129",
  "crash_class": "stack-buffer-overflow",
  "signal": "SIGABRT",
  "root_cause_line": 12,
  "root_cause_marker": "slots[idx] = val",
  "crashing_stdin": "set -3 9\n",
  "functional_tests": [
